/* Светлая тема «Подвеска.Про»: бумажный фон, синий акцент. */

QWidget {
    background-color: #f2f4f7;
    color: #1d2530;
    font-size: 13px;
}

QMainWindow::separator {
    background: #d7dde4;
    width: 3px;
    height: 3px;
}

QMenuBar {
    background-color: #ffffff;
    border-bottom: 1px solid #dfe4ea;
}
QMenuBar::item {
    padding: 5px 10px;
    background: transparent;
}
QMenuBar::item:selected {
    background: #dbe7fb;
    border-radius: 4px;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #d7dde4;
    padding: 4px;
}
QMenu::item {
    padding: 6px 24px 6px 20px;
    border-radius: 4px;
}
QMenu::item:selected {
    background: #dbe7fb;
}
QMenu::separator {
    height: 1px;
    background: #e6eaef;
    margin: 4px 8px;
}

QToolBar {
    background: #ffffff;
    border-bottom: 1px solid #dfe4ea;
    spacing: 4px;
    padding: 3px 6px;
}
QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 4px 8px;
}
QToolButton:hover {
    background: #eef2f7;
    border-color: #d7dde4;
}
QToolButton:checked {
    background: #1c6dd0;
    border-color: #1c6dd0;
    color: #ffffff;
}

QDockWidget {
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
    font-weight: 600;
}
QDockWidget::title {
    background: #ffffff;
    padding: 6px 8px;
    border-bottom: 1px solid #dfe4ea;
}

QTreeWidget, QTreeView, QTableWidget, QListWidget {
    background: #ffffff;
    alternate-background-color: #f7f9fb;
    border: 1px solid #dfe4ea;
    selection-background-color: #1c6dd0;
    selection-color: #ffffff;
    outline: none;
}
QTreeWidget::item, QTreeView::item {
    padding: 3px 2px;
    border-radius: 3px;
}
QTreeWidget::item:hover, QTreeView::item:hover {
    background: #eef2f7;
}

QTabWidget::pane {
    border: 1px solid #dfe4ea;
    background: #f7f9fb;
}
QTabBar::tab {
    background: #ffffff;
    color: #5b6774;
    padding: 7px 16px;
    border: 1px solid #dfe4ea;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background: #f7f9fb;
    color: #1d2530;
}
QTabBar::tab:hover:!selected {
    background: #f0f4f8;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: #ffffff;
    border: 1px solid #cfd6de;
    border-radius: 5px;
    padding: 3px 6px;
    selection-background-color: #1c6dd0;
    selection-color: #ffffff;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #1c6dd0;
}
QLineEdit[invalid="true"] {
    border-color: #c62828;
    background: #fdecec;
}
QLineEdit[outOfRange="true"] {
    border-color: #c77700;
    background: #fff6e0;
}
QComboBox::drop-down {
    border: none;
    width: 18px;
}
QComboBox QAbstractItemView {
    background: #ffffff;
    border: 1px solid #cfd6de;
    selection-background-color: #dbe7fb;
    selection-color: #1d2530;
}

QPushButton {
    background: #ffffff;
    border: 1px solid #cfd6de;
    border-radius: 6px;
    padding: 6px 14px;
}
QPushButton:hover {
    background: #eef2f7;
}
QPushButton:pressed {
    background: #e3e9f0;
}
QPushButton:default {
    background: #1c6dd0;
    border-color: #1c6dd0;
    color: #ffffff;
}
QPushButton:disabled {
    color: #9aa4b0;
    background: #f2f4f7;
}

QSlider::groove:horizontal {
    height: 5px;
    background: #dfe4ea;
    border-radius: 2px;
}
QSlider::sub-page:horizontal {
    background: #1c6dd0;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: #ffffff;
    border: 1px solid #8a97a5;
    width: 13px;
    height: 13px;
    margin: -5px 0;
    border-radius: 7px;
}
QSlider::handle:horizontal:hover {
    border-color: #1c6dd0;
}
QSlider::handle:horizontal:disabled {
    background: #e3e9f0;
    border-color: #b8c2cd;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #b8c2cd;
    border-radius: 3px;
    background: #ffffff;
}
QCheckBox::indicator:checked {
    background: #1c6dd0;
    border-color: #1c6dd0;
}

QGroupBox {
    border: 1px solid #dfe4ea;
    border-radius: 6px;
    margin-top: 14px;
    padding-top: 6px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #5b6774;
}

QStatusBar {
    background: #ffffff;
    border-top: 1px solid #dfe4ea;
    color: #5b6774;
}

QToolTip {
    background-color: #ffffff;
    color: #1d2530;
    border: 1px solid #cfd6de;
    padding: 6px;
}

QScrollBar:vertical {
    background: #f2f4f7;
    width: 12px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #c8d1da;
    border-radius: 6px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: #b3bec9;
}
QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}
QScrollBar:horizontal {
    background: #f2f4f7;
    height: 12px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #c8d1da;
    border-radius: 6px;
    min-width: 24px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    height: 0;
    width: 0;
}

QFrame#EmptyState {
    background: #ffffff;
    border: 1px dashed #cfd6de;
    border-radius: 10px;
}

QLabel#EmptyTitle {
    font-size: 20px;
    font-weight: 700;
}

QLabel#EmptySubtitle {
    color: #5b6774;
}

QLabel#DiagramTitle {
    color: #5b6774;
    font-weight: 600;
}

QLabel#Hint {
    color: #6b7783;
}

QFrame#Section {
    background: #ffffff;
    border: 1px solid #dfe4ea;
    border-radius: 6px;
}
