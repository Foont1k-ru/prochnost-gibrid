/* Тёмная тема «Подвеска.Про»: графит с синим акцентом. */

QWidget {
    background-color: #20242a;
    color: #e6ebf1;
    font-size: 13px;
}

QMainWindow::separator {
    background: #2b3138;
    width: 3px;
    height: 3px;
}

QMenuBar {
    background-color: #1b1f24;
    border-bottom: 1px solid #2b3138;
}
QMenuBar::item {
    padding: 5px 10px;
    background: transparent;
}
QMenuBar::item:selected {
    background: #2f6fd0;
    border-radius: 4px;
}

QMenu {
    background-color: #262b32;
    border: 1px solid #39414b;
    padding: 4px;
}
QMenu::item {
    padding: 6px 24px 6px 20px;
    border-radius: 4px;
}
QMenu::item:selected {
    background: #2f6fd0;
}
QMenu::separator {
    height: 1px;
    background: #39414b;
    margin: 4px 8px;
}

QToolBar {
    background: #1b1f24;
    border-bottom: 1px solid #2b3138;
    spacing: 4px;
    padding: 3px 6px;
}
QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 4px 8px;
}
QToolButton:hover {
    background: #2a3038;
    border-color: #39414b;
}
QToolButton:checked {
    background: #2f6fd0;
    border-color: #2f6fd0;
}

QDockWidget {
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
    font-weight: 600;
}
QDockWidget::title {
    background: #1b1f24;
    padding: 6px 8px;
    border-bottom: 1px solid #2b3138;
}

QTreeWidget, QTreeView, QTableWidget, QListWidget {
    background: #1c2127;
    alternate-background-color: #20252b;
    border: 1px solid #2b3138;
    selection-background-color: #2f6fd0;
    selection-color: #ffffff;
    outline: none;
}
QTreeWidget::item, QTreeView::item {
    padding: 3px 2px;
    border-radius: 3px;
}
QTreeWidget::item:hover, QTreeView::item:hover {
    background: #262d35;
}

QTabWidget::pane {
    border: 1px solid #2b3138;
    background: #20242a;
}
QTabBar::tab {
    background: #1b1f24;
    color: #9fb0c2;
    padding: 7px 16px;
    border: 1px solid #2b3138;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background: #262d35;
    color: #ffffff;
}
QTabBar::tab:hover:!selected {
    background: #242a31;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: #171a1f;
    border: 1px solid #39414b;
    border-radius: 5px;
    padding: 3px 6px;
    selection-background-color: #2f6fd0;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #2f6fd0;
}
QLineEdit[invalid="true"] {
    border-color: #ff6b6b;
    background: #3a2020;
}
QLineEdit[outOfRange="true"] {
    border-color: #ffc857;
    background: #3a3320;
}
QComboBox::drop-down {
    border: none;
    width: 18px;
}
QComboBox QAbstractItemView {
    background: #262b32;
    border: 1px solid #39414b;
    selection-background-color: #2f6fd0;
}

QPushButton {
    background: #2a3038;
    border: 1px solid #39414b;
    border-radius: 6px;
    padding: 6px 14px;
}
QPushButton:hover {
    background: #333b45;
}
QPushButton:pressed {
    background: #232a32;
}
QPushButton:default {
    background: #2f6fd0;
    border-color: #2f6fd0;
    color: #ffffff;
}
QPushButton:disabled {
    color: #6b7683;
    background: #23272d;
}

QSlider::groove:horizontal {
    height: 5px;
    background: #333a43;
    border-radius: 2px;
}
QSlider::sub-page:horizontal {
    background: #2f6fd0;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: #dfe7f0;
    border: 1px solid #7d8b9b;
    width: 13px;
    height: 13px;
    margin: -5px 0;
    border-radius: 7px;
}
QSlider::handle:horizontal:hover {
    background: #ffffff;
}
QSlider::handle:horizontal:disabled {
    background: #5b6673;
    border-color: #4a545f;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #4a545f;
    border-radius: 3px;
    background: #171a1f;
}
QCheckBox::indicator:checked {
    background: #2f6fd0;
    border-color: #2f6fd0;
}

QGroupBox {
    border: 1px solid #2b3138;
    border-radius: 6px;
    margin-top: 14px;
    padding-top: 6px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #9fb0c2;
}

QStatusBar {
    background: #1b1f24;
    border-top: 1px solid #2b3138;
    color: #9fb0c2;
}

QToolTip {
    background-color: #2a3038;
    color: #e6ebf1;
    border: 1px solid #39414b;
    padding: 6px;
}

QScrollBar:vertical {
    background: #1c2127;
    width: 12px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #3a424c;
    border-radius: 6px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: #4a545f;
}
QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}
QScrollBar:horizontal {
    background: #1c2127;
    height: 12px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #3a424c;
    border-radius: 6px;
    min-width: 24px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    height: 0;
    width: 0;
}

QFrame#EmptyState {
    background: #1c2127;
    border: 1px dashed #39414b;
    border-radius: 10px;
}

QLabel#EmptyTitle {
    font-size: 20px;
    font-weight: 700;
}

QLabel#EmptySubtitle {
    color: #9fb0c2;
}

QLabel#DiagramTitle {
    color: #9fb0c2;
    font-weight: 600;
}

QLabel#Hint {
    color: #7f8c9b;
}

QFrame#Section {
    background: #1c2127;
    border: 1px solid #2b3138;
    border-radius: 6px;
}
